<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Xpand.Events.Core</AssemblyName>
        <RootNamespace>Xpand.Events</RootNamespace>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <LangVersion>8</LangVersion>
        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>rc.1</VersionSuffix>
        <IsPackable>true</IsPackable>
        <Authors>Nikolay Nakorkeshko</Authors>
        <Title>Xpand Events Core</Title>
        <Description>Dependency-free synchronous in-process signals with disposable subscriptions and deterministic ordering.</Description>
        <Copyright>Copyright (c) 2025 Nikolay Nakorkeshko</Copyright>
        <PackageProjectUrl>https://github.com/ShortKedr/xpand-events</PackageProjectUrl>
        <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>xpand-events-icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/ShortKedr/xpand-events</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <EnablePackageValidation>true</EnablePackageValidation>
        <EnableStrictModeForCompatibleFrameworksInPackage>true</EnableStrictModeForCompatibleFrameworksInPackage>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageTags>events;signals;in-process;unity</PackageTags>
        <PackageReleaseNotes>Xpand Events 1.0 release candidate for dependency-free synchronous signals. See CHANGELOG.md and ROADMAP.md for validation status.</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\unity\com.xpand.events\Runtime\Core\**\*.cs" Link="Signals\%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\assets\xpand-events-icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Authors>Nikolay Nakorkeshko</Authors>
        <LangVersion>8</LangVersion>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>rc.1</VersionSuffix>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IsPackable>true</IsPackable>
        <Title>Xpand Events Legacy Compatibility</Title>
        <Description>Compatibility package for the experimental legacy XEvent API. New code should use Xpand.Events.Core.</Description>
        <Copyright>Copyright (c) 2025 Nikolay Nakorkeshko</Copyright>
        <PackageProjectUrl>https://github.com/ShortKedr/xpand-events</PackageProjectUrl>
        <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>xpand-events-icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/ShortKedr/xpand-events</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <EnablePackageValidation>true</EnablePackageValidation>
        <EnableStrictModeForCompatibleFrameworksInPackage>true</EnableStrictModeForCompatibleFrameworksInPackage>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Legacy delegates predate nullable metadata; preserve the compatibility facade as oblivious. -->
        <NoWarn>$(NoWarn);CS1591;RS0041</NoWarn>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageTags>events;signals;in-process;unity</PackageTags>
        <PackageReleaseNotes>Xpand Events 1.0 release-candidate compatibility facade for migration from XEvent to Signal.</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <Optimize>true</Optimize>
    </PropertyGroup>

    <ItemGroup>
      <None Include="..\README.md" Pack="true" PackagePath="\" />
      <None Include="..\assets\xpand-events-icon.png" Pack="true" PackagePath="\" />
      <Folder Include="Aliases" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Xpand.Events.Core\Xpand.Events.Core.csproj" />
      <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      </PackageReference>
      <ApiCompatSuppressionFile Include="CompatibilitySuppressions.xml" />
    </ItemGroup>

</Project>
